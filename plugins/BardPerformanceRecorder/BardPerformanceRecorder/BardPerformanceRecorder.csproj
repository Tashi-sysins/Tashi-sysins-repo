<Project Sdk="Dalamud.NET.SDK/14.0.0">
    <PropertyGroup>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
        <Version>0.1.0.0</Version>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>AnyCPU;x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- MidiBard2 と同じ 7.2.0 に合わせる（設計図の指定） -->
        <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Dalamud.Bindings.ImGui"
                   HintPath="$(AppData)\XIVLauncher\addon\Hooks\dev\Dalamud.Bindings.ImGui.dll"
                   Private="false" />
    </ItemGroup>
</Project>
