<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- 本体は Dalamud SDK 依存なので、検証したいファイルだけを直接取り込む。
             こうすればゲームもDalamudも無しに MIDI 変換を検証できる。 -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>BprecTests</AssemblyName>
        <RootNamespace>BardPerformanceRecorder.Tests</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Melanchall.DryWetMidi" Version="7.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <!-- ゲームに依存しない層だけを取り込む -->
        <Compile Include="..\BardPerformanceRecorder\Midi\MidiExporter.cs" Link="MidiExporter.cs" />
        <Compile Include="..\BardPerformanceRecorder\Midi\InstrumentNames.cs" Link="InstrumentNames.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\ContinuousPolicy.cs" Link="ContinuousPolicy.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\NoteEventRecord.cs" Link="NoteEventRecord.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\PerformanceRecorder.cs" Link="PerformanceRecorder.cs" />
        <Compile Include="..\BardPerformanceRecorder\Game\PerformancePackets.cs" Link="PerformancePackets.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\RawPacketLog.cs" Link="RawPacketLog.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\LocalKeyLog.cs" Link="LocalKeyLog.cs" />
        <Compile Include="..\BardPerformanceRecorder\Recording\CalibrationAnalyzer.cs" Link="CalibrationAnalyzer.cs" />
    </ItemGroup>
</Project>
